{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://featurerequest.io/agent/contract.schema.json",
  "title": "FeatureRequest Agent Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "agent_contract_version",
    "product",
    "identity",
    "compatibility",
    "scopes",
    "capabilities",
    "limits",
    "bootstrap",
    "server_instructions",
    "resources",
    "authorization_policies",
    "data_classifications",
    "audit",
    "idempotency_policy",
    "application_errors",
    "mapping",
    "tools",
    "$defs"
  ],
  "properties": {
    "$schema": {"const": "./contract.schema.json"},
    "schema_version": {"const": "1"},
    "agent_contract_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "product": {"$ref": "#/$defs/product"},
    "identity": {"$ref": "#/$defs/identity"},
    "compatibility": {"$ref": "#/$defs/compatibility"},
    "scopes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write"],
      "properties": {
        "read": {"$ref": "#/$defs/catalog_entry"},
        "write": {"$ref": "#/$defs/catalog_entry"}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_management",
        "request_management",
        "request_collaboration",
        "duplicate_evidence",
        "delivery_evidence",
        "activity_feed",
        "project_specification"
      ],
      "properties": {
        "project_management": {"$ref": "#/$defs/capability"},
        "request_management": {"$ref": "#/$defs/capability"},
        "request_collaboration": {"$ref": "#/$defs/capability"},
        "duplicate_evidence": {"$ref": "#/$defs/capability"},
        "delivery_evidence": {"$ref": "#/$defs/capability"},
        "activity_feed": {"$ref": "#/$defs/capability"},
        "project_specification": {"$ref": "#/$defs/capability"}
      }
    },
    "limits": {"$ref": "#/$defs/limits"},
    "bootstrap": {"$ref": "#/$defs/bootstrap"},
    "server_instructions": {"$ref": "#/$defs/server_instructions"},
    "resources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/resource"}
    },
    "authorization_policies": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/authorization_policy"}
    },
    "data_classifications": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/data_classification"}
    },
    "audit": {"$ref": "#/$defs/audit"},
    "idempotency_policy": {"$ref": "#/$defs/idempotency_policy"},
    "application_errors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/application_error"}
    },
    "mapping": {"$ref": "#/$defs/mapping"},
    "tools": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/tool"}
    },
    "$defs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "required": ["application_error_envelope"],
      "additionalProperties": {"type": "object", "minProperties": 1},
      "properties": {
        "application_error_envelope": {
          "type": "object",
          "additionalProperties": true,
          "required": ["type", "additionalProperties", "required", "properties"],
          "properties": {
            "type": {"const": "object"},
            "additionalProperties": {"const": false},
            "required": {"const": ["code", "message", "retryable", "request_id", "details"]},
            "properties": {"type": "object"}
          }
        }
      }
    }
  },
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1},
    "catalog_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {"description": {"$ref": "#/$defs/non_empty_string"}}
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "slug", "supported_goals", "excluded_goals"],
      "properties": {
        "name": {"const": "FeatureRequest"},
        "slug": {"const": "feature-request"},
        "supported_goals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "excluded_goals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "client", "tenant"],
      "properties": {
        "actor": {"const": "authenticated_actor_id"},
        "client": {"const": "authenticated_client_id"},
        "tenant": {"type": "null"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "support_window_days", "versioning", "release_tag_pattern"],
      "properties": {
        "strategy": {"enum": ["additive_superset", "versioned_tool", "versioned_endpoint"]},
        "support_window_days": {"const": 90},
        "versioning": {"const": "semver"},
        "release_tag_pattern": {"const": "agent-contract-v{agent_contract_version}"},
        "breaking_decision_ref": {
          "type": "string",
          "pattern": "^release/decisions/[a-z0-9][a-z0-9._-]*\\.ya?ml$"
        },
        "previous_major_support_until": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "available_on"],
      "properties": {
        "description": {"$ref": "#/$defs/non_empty_string"},
        "available_on": {"const": ["free", "pro_30"]}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_count"],
      "properties": {
        "project_count": {
          "type": "object",
          "additionalProperties": false,
          "required": ["period", "reset_at", "by_plan", "enforcement"],
          "properties": {
            "period": {"const": "lifetime"},
            "reset_at": {"type": "null"},
            "by_plan": {
              "type": "object",
              "additionalProperties": false,
              "required": ["free", "pro_30"],
              "properties": {"free": {"const": 1}, "pro_30": {"const": 30}}
            },
            "enforcement": {"const": "atomic_with_create_project"}
          }
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool"],
      "properties": {"tool": {"const": "get_account_capabilities"}}
    },
    "server_instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "rules"],
      "properties": {
        "summary": {"$ref": "#/$defs/non_empty_string"},
        "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "text": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "owner_rule", "tenant_rule", "revisioned"],
      "properties": {
        "description": {"$ref": "#/$defs/non_empty_string"},
        "owner_rule": {"$ref": "#/$defs/non_empty_string"},
        "tenant_rule": {"const": "not_applicable"},
        "revisioned": {"type": "boolean"}
      }
    },
    "authorization_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "evaluation"],
      "properties": {
        "description": {"$ref": "#/$defs/non_empty_string"},
        "evaluation": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "data_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "trust", "audit"],
      "properties": {
        "description": {"$ref": "#/$defs/non_empty_string"},
        "trust": {"enum": ["trusted", "untrusted", "restricted", "secret"]},
        "audit": {"enum": ["allowed", "redacted", "forbidden"]}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retention_days", "domain_activity_retention", "required_fields", "forbidden_fields", "profiles"],
      "properties": {
        "retention_days": {"const": 90},
        "domain_activity_retention": {"const": "resource_lifetime"},
        "required_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "forbidden_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "profiles": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/audit_profile"}}
      }
    },
    "audit_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record", "extra_fields"],
      "properties": {
        "record": {"type": "boolean"},
        "extra_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "idempotency_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guarantee_hours", "key_scope", "same_input", "different_input", "canonicalization", "uncertain_result"],
      "properties": {
        "guarantee_hours": {"const": 24},
        "key_scope": {"const": "authenticated_actor_id+tool_name"},
        "same_input": {"const": "return_original_result"},
        "different_input": {"const": "idempotency_conflict"},
        "canonicalization": {"const": "rfc8785_json"},
        "uncertain_result": {"const": "authoritative_read_before_retry"}
      }
    },
    "application_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "retryable", "details"],
      "properties": {
        "message": {"$ref": "#/$defs/non_empty_string"},
        "retryable": {"type": "boolean"},
        "details": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "read_only_hint", "destructive_hint", "open_world_hint", "security", "excluded_from_security_scopes"],
      "properties": {
        "snapshot": {
          "type": "string",
          "pattern": "^agent/mappings/mcp-(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?\\.json$"
        },
        "read_only_hint": {"const": "side_effect == read_only"},
        "destructive_hint": {"const": "destructive"},
        "open_world_hint": {"const": "open_world"},
        "security": {"const": "authentication required maps exact required_scopes; none maps no requirement"},
        "excluded_from_security_scopes": {"const": ["capability", "ownership", "plan", "limit"]}
      }
    },
    "json_schema": {"type": "object", "minProperties": 1},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "owner", "conditions", "confirmation_field", "preconditions"],
      "properties": {
        "mode": {"enum": ["none", "always", "conditional"]},
        "owner": {"enum": ["none", "agent", "client"]},
        "conditions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "confirmation_field": {"type": ["string", "null"]},
        "preconditions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "tool_idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "key_field", "key_scope", "guarantee_hours", "replay", "conflict", "uncertain_result"],
      "properties": {
        "mode": {"enum": ["not_required", "required"]},
        "key_field": {"type": ["string", "null"]},
        "key_scope": {"type": ["string", "null"]},
        "guarantee_hours": {"type": ["integer", "null"], "minimum": 1},
        "replay": {"enum": ["not_applicable", "return_original_result"]},
        "conflict": {"enum": ["not_applicable", "idempotency_conflict"]},
        "uncertain_result": {"enum": ["not_applicable", "authoritative_read_before_retry"]}
      }
    },
    "tool_data_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "untrusted_output", "audit_redaction"],
      "properties": {
        "input": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "output": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "untrusted_output": {"type": "boolean"},
        "audit_redaction": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "long_running": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "reason"],
      "properties": {
        "mode": {"enum": ["not_applicable", "operation"]},
        "reason": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title", "description", "exposure", "input_schema", "output_schema",
        "authentication", "required_scopes", "required_capabilities", "resource_type",
        "ownership", "side_effect", "destructive", "open_world", "approval",
        "idempotency", "errors", "data_classification", "audit_profile", "long_running"
      ],
      "properties": {
        "title": {"$ref": "#/$defs/non_empty_string"},
        "description": {"$ref": "#/$defs/non_empty_string"},
        "exposure": {"enum": ["public", "internal"]},
        "input_schema": {"$ref": "#/$defs/json_schema"},
        "output_schema": {"$ref": "#/$defs/json_schema"},
        "authentication": {"enum": ["required", "none"]},
        "required_scopes": {"type": "array", "uniqueItems": true, "items": {"enum": ["read", "write"]}},
        "required_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "resource_type": {"type": "string"},
        "ownership": {"type": "string"},
        "side_effect": {"enum": ["read_only", "reversible_write", "irreversible_write", "external_effect"]},
        "destructive": {"type": "boolean"},
        "open_world": {"type": "boolean"},
        "approval": {"$ref": "#/$defs/approval"},
        "idempotency": {"$ref": "#/$defs/tool_idempotency"},
        "errors": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "data_classification": {"$ref": "#/$defs/tool_data_classification"},
        "audit_profile": {"type": "string"},
        "long_running": {"$ref": "#/$defs/long_running"}
      }
    }
  }
}
