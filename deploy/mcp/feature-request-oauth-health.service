[Unit]
Description=FeatureRequest OAuth/MCP cleanup health check (native exact checkout)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/srv/apps/__PROJECT_NAME__/venv/bin/python

[Service]
Type=oneshot
User=__APP_USER__
Group=__APP_GROUP__
WorkingDirectory=/srv/apps/__PROJECT_NAME__
Environment=PATH=/srv/apps/__PROJECT_NAME__/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/srv/apps/__PROJECT_NAME__/venv/bin/python scripts/verify_mcp_deploy_config.py --env-file /srv/apps/__PROJECT_NAME__/.env --project-dir /srv/apps/__PROJECT_NAME__
ExecStart=/srv/apps/__PROJECT_NAME__/venv/bin/python manage.py check_mcp_oauth_health
NoNewPrivileges=true
PrivateTmp=true
