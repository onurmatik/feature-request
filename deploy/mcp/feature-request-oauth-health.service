[Unit]
Description=FeatureRequest OAuth/MCP cleanup health check
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/featurerequest/mcp.env
ExecStartPre=/usr/bin/python3 /opt/featurerequest/scripts/verify_mcp_deploy_config.py --env-file /etc/featurerequest/mcp.env
ExecStart=/usr/bin/docker run --rm --network host --env-file /etc/featurerequest/mcp.env ${FEATURE_REQUEST_IMAGE_REF} python manage.py check_mcp_oauth_health
NoNewPrivileges=true
