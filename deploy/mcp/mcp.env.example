# Copy to /etc/featurerequest/mcp.env with mode 0600. Never commit real values.
FEATURE_REQUEST_IMAGE_REF=ghcr.io/onurmatik/feature-request@sha256:REPLACE_WITH_64_HEX
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST/feature_request
DJANGO_SECRET_KEY=REPLACE_SECRET
DEBUG=false
ALLOWED_HOSTS=featurerequest.io
PUBLIC_BASE_URL=https://featurerequest.io
OAUTH_ISSUER=https://featurerequest.io
MCP_RESOURCE_URL=https://featurerequest.io/mcp
MCP_RESOURCE_METADATA_URL=https://featurerequest.io/.well-known/oauth-protected-resource/mcp
FEATURE_REQUEST_MCP_PRODUCTION_ENABLED=true
FEATURE_REQUEST_MCP_HOST=127.0.0.1
FEATURE_REQUEST_MCP_PORT=8001
FEATURE_REQUEST_MCP_CORS_ORIGINS=https://chatgpt.com,https://claude.ai,https://claude.com
FEATURE_REQUEST_TRUSTED_PROXY_IPS=127.0.0.1,::1
CSRF_TRUSTED_ORIGINS=https://featurerequest.io
ADMIN_EMAIL=REPLACE_ADMIN_EMAIL
EMAIL_BACKEND=django_ses.SESBackend
