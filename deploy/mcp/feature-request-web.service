[Unit]
Description=FeatureRequest web service (digest-pinned container)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
EnvironmentFile=/etc/featurerequest/mcp.env
ExecStartPre=/usr/bin/python3 /opt/featurerequest/scripts/verify_mcp_deploy_config.py --env-file /etc/featurerequest/mcp.env
ExecStartPre=-/usr/bin/docker rm -f feature-request-web
ExecStart=/usr/bin/docker run --rm --name feature-request-web --network host --env-file /etc/featurerequest/mcp.env ${FEATURE_REQUEST_IMAGE_REF} gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 2 --access-logfile - --access-logformat "%(p)s %(h)s %(m)s %(U)s %(H)s %(s)s %(L)s"
ExecStop=/usr/bin/docker stop -t 30 feature-request-web
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
