[Unit]
Description=FeatureRequest stateless OAuth MCP service (native exact checkout)
After=network-online.target app@__PROJECT_NAME__.socket
Wants=network-online.target
ConditionPathExists=/srv/apps/__PROJECT_NAME__/venv/bin/python

[Service]
Type=simple
User=__APP_USER__
Group=__APP_GROUP__
WorkingDirectory=/srv/apps/__PROJECT_NAME__
Environment=PATH=/srv/apps/__PROJECT_NAME__/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/srv/apps/__PROJECT_NAME__/venv/bin/python scripts/verify_mcp_deploy_config.py --env-file /srv/apps/__PROJECT_NAME__/.env --project-dir /srv/apps/__PROJECT_NAME__
ExecStart=/srv/apps/__PROJECT_NAME__/venv/bin/python -m feature_request_mcp
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
